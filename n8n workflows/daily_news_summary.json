        "jsonBody": "={\n  model: \"deepseek-r1:14b\",\n  prompt: `\nYou are an expert news editor writing for ADHD readers.\n\nSummarize this article:\n\n${$json.article}\n\nReturn:\n- What happened\n- Why it matters\n- Key detail\n- Quick Take (max 3 bullets)\n`,\n  stream: false\n}",

        "jsCode": "return {\n  articles: items.map(item => ({\n    ...item.json,\n    source: 'ANSA',\n    selector: \"div[itemprop='articleBody']\"\n  })), \n\n  required: ['title', 'link'],\n\n  mapped: {\n    title: 'title',\n    link: 'link',\n    pubDate: ['pubDate', 'isoDate'],\n    snippet: ['contentSnippet', 'content']\n  },\n};"

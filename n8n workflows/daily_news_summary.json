    {
      "parameters": {
        "jsCode": "const raw = ($json.response || '').replace(/<think>[\\s\\S]*?<\\/think>/g, '').trim();\nreturn {\n  json: {\n    ...$json,\n    summary: raw\n  }\n};"
      },
      "id": "49fd689c-762d-4491-a3fb-83c9cf8734e1",
      "name": "Enrich with Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        10224,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "const articles = $input.all().map(item => item.json);\n\nconst summary = articles\n  .map((a, i) => `${i + 1}. **${a.title}** (${a.source})\\n${a.summary}`)\n  .join('\\n\\n');\n\nreturn [{ json: { articles, summary } }];"
      },
      "id": "c726d747-4f10-4b0e-ad55-818fd9f5ca51",
      "name": "Aggregate for Overview",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        10032,
        -272
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_OLLAMA_BASE_URL }}/api/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  model: $env.N8N_LLM_REASONING_MODEL_2,\n  prompt: `You are a news editor writing a daily overview.\n\nBelow are today's article summaries:\n\n${$json.summary}\n\n---\n\nWrite a quick summary capturing the most important themes and developments of the day. Be direct, factual, and clear. No fluff.\n`,\n  stream: false,\n  keep_alive: \"30m\"\n} }}",
        "options": {
          "timeout": 600000
        }
      },
      "id": "9a330bb6-5be8-4ab1-ac65-a03129a792cf",
      "name": "Ollama Overview",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        10240,
        -144
      ]
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      },
      "id": "0af2fe87-2dfc-4ffc-adbf-97059f2b2a0d",
      "name": "Merge Overview with Articles",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        10416,
        -256
      ]
    },
    {
      "parameters": {
        "jsCode": "const overviewResponse = $json.response || '';\nconst articles = $json.articles || [];\n\nconst now = new Date();\nconst pad = n => String(n).padStart(2, '0');\nconst date = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;\n\nconst articlesSection = articles.map(a => {\n  const dateLine = a.pubDate ? `\\n*${a.pubDate}*` : '';\n  return [\n    `### ${a.title}`,\n    `**Source:** ${a.source}${dateLine} | [Read more](${a.link || a.url})`,\n    '',\n    a.summary\n  ].join('\\n');\n}).join('\\n\\n---\\n\\n');\n\nconst text = [\n  `# Daily News Briefing — ${date}`,\n  '',\n  '## Overview',\n  overviewResponse,\n  '',\n  '---',\n  '',\n  '## Articles',\n  '',\n  articlesSection\n].join('\\n');\n\nreturn [{\n  json: {\n    text,\n    summaryText: text,\n    filename: `news-summary-${date}.md`,\n    subject: `Daily News Summary - ${date}`,\n    overview: overviewResponse,\n    articles\n  }\n}];"
      },
      "id": "7a2bdd89-aa4d-4d91-be3e-8dbb380003ab",
      "name": "Prepare Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,

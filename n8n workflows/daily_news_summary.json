      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_OLLAMA_BASE_URL }}/api/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  model: $env.N8N_LLM_REASONING_MODEL_2,\n  prompt: `You are a news editor writing for ADHD readers. The article may be in Italian — read it, understand it, and write a concise English summary.\n\nARTICLE:\nTitle: ${$json.title}\nSource: ${$json.source}\n\n${$json.article || $json.snippet || ''}\n\n---\n\nWrite a summary following these rules:\n- ADHD friendly\n- Significant or complex news: use **bold** for key names, numbers, dates\n- No fluff, no repetition, no meta-commentary\n- Do NOT include URLs, source names, or the title — only the summary text\n- Write in English regardless of the article's original language\n`,\n  stream: false,\n  keep_alive: \"30m\"\n} }}",
        "options": {
          "timeout": 600000
        }
      },
      "id": "fdda9699-1d83-4954-9f81-5b9cfbe16e51",
      "name": "Ollama Translate & Summarize",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        9760,
        128
      ]
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      },

    {
      "parameters": {
        "jsCode": "// Input:\n// - sourceObj: original object (item.json)\n// - requiredFields: fields that must exist in output as-is (or empty string)\n// - mappedFields: { outputField: sourceField | [sourceField1, sourceField2, ...] }\n//\n// Rules:\n// - runDate is always added automatically\n// - if source field is missing => ''\n// - if source field is an array, first existing value is used\nfunction normalizeObject(sourceObj, mappedFields = {}) {\n  // non mapped fields are kept as is\n  const result = {...sourceObj};\n\n  // Mapped fields\n  for (const [targetField, sourceFields] of Object.entries(mappedFields)) {\n    const fieldsToCheck = Array.isArray(sourceFields)\n      ? sourceFields\n      : [sourceFields];\n\n    let value = '';\n\n    for (const field of fieldsToCheck) {\n      if (sourceObj[field]) {\n        value = sourceObj[field];\n        break;\n      }\n    }\n\n    result[targetField] = value;\n  }\n\n  // Auto-added fields\n  result.runDate = new Date().toISOString();\n\n  return result;\n}\n\nfunction passesFilters(obj, filters = []) {\n  if (!filters.length) return true;\n\n  return filters.every(field => !!obj[field]);\n}\n\nreturn (items.flatMap(item =>\n  (item.json.articles || [])\n    .map(article =>\n      normalizeObject(article, item.json.mapped)\n    )\n    .filter(article =>\n      passesFilters(article, item.json.required)\n    )\n));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -368,
        320
      ],
      "id": "998ef9cf-45ab-4291-a285-d18bc3f190d9",

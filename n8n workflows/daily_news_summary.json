    {
      "parameters": {
        "functionCode": "const first = items[0];\n\nconst summary =\n  first.json.response ||\n  first.json.message?.content ||\n  first.json.message ||\n  first.json.body?.response ||\n  first.json.body?.message?.content ||\n  JSON.stringify(first.json, null, 2);\n\nconst now = new Date();\nconst pad = (n) => String(n).padStart(2, '0');\nconst filename = `/data/news-summaries/news-summary-${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}.md`;\n\nreturn [\n  {\n    json: {\n      summary,\n      filename,\n      subject: `Daily News Summary - ${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`\n    }\n  }\n];"
      },

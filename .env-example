# Your Linux username — used to mount the shared ~/.ollama model directory into the container.
LINUX_USERNAME=username


# ---------- PORTS ----------
# Host-side port each service is exposed on. Change these if you have conflicts.
N8N_PORT=5678
WEBUI_PORT=3000
OLLAMA_PORT=11434
# URL n8n uses to reach Ollama. Use the Docker service name (ollama) when both run in the same compose stack.
OLLAMA_BASE_URL=http://ollama:11434

# ---------- OLLAMA ----------
# Log level for the Ollama server (DEBUG, INFO, WARN, ERROR).
OLLAMA_DEBUG=INFO
# Log the full request body for every /api/* call — useful for debugging prompts.
OLLAMA_DEBUG_LOG_REQUESTS=true
# Number of CPU threads Ollama uses. Keep low if you want to leave headroom for other processes.
OLLAMA_NUM_THREAD=1
# How long a loaded model stays in VRAM when idle before being evicted. Format: 5m, 1h, 0 (never unload).
OLLAMA_KEEP_ALIVE=5m

# ---------- OLLAMA RESOURCES ----------
# Hard RAM ceiling for the Ollama container (Docker enforced).
OLLAMA_MEM_LIMIT=16g
# Shared memory allocated to the container — CUDA kernels use this for inter-process communication.
OLLAMA_SHM_SIZE=8g
# Maximum CPU cores Docker allows the container to use.
OLLAMA_CPUS=8.0


# ---------- N8N ----------
# Hostname n8n binds to. Use localhost for local-only access, 0.0.0.0 to expose externally.
N8N_HOST=localhost
N8N_PROTOCOL=http
# Base URL used when constructing webhook URLs shown in the UI.
WEBHOOK_URL=http://localhost:5678/
# Timezone for cron triggers and log timestamps.
GENERIC_TIMEZONE=Europe/Rome

# Absolute path (inside the n8n Docker container) where workflow data files are written.
# The default n8n data directory is /home/node/.n8n — mount a host volume there if you
# want the files to survive container restarts.
N8N_DATA_PATH=/home/node/.n8n


# ---------- N8N LLM SETTINGS ----------
# Maximum characters fed to the overview LLM prompt. Higher = richer context, slower and more VRAM.
N8N_OVERVIEW_MAX_CHARS=8000
# Number of GPU layers to offload to the GPU.
# Leave UNSET (or empty) to let Ollama use all available GPU layers — this is the recommended default.
# Set to 0 to run fully on CPU. Set to a specific number to cap GPU usage (useful on shared machines).
# Do NOT set to an arbitrary large number (e.g. 999) — some models reject out-of-range values.
N8N_LLM_NUM_GPU=


# ---------- MODELS ----------
# Lightweight model: Fast model for low-stakes tasks.
N8N_LLM_FAST_MODEL=qwen3.5:9b
# Reasoning model: Best for multi-step reasoning, logic chains, math-style thinking.
N8N_LLM_REASONING_MODEL=deepseek-r1:32b
# Reasoning model: Best for general intelligence, broad knowledge, strong language tasks.
N8N_LLM_REASONING_MODEL_2=qwen3.6:35b
# Code specialist model
N8N_LLM_CODE_MODEL=qwen3-coder:30b
# Vision model: Multimodal model capable of understanding images alongside text.
N8N_LLM_VISION_MODEL=llava:13b
# Embedding model: used for semantic search and similarity tasks.
N8N_LLM_EMBED_MODEL=nomic-embed-text


# ---------- WEBUI ----------
# Allow new users to self-register. Set to false once you have created your account.
ENABLE_SIGNUP=true
# Secret used to sign session tokens. Must be a long random string in production.
WEBUI_SECRET_KEY=change-me-to-a-long-random-secret
# Maximum tokens the model can generate per response in the chat UI.
MAX_RESPONSE_TOKENS=1024
# Seconds before an in-flight request to Ollama is cancelled by the web UI.
REQUEST_TIMEOUT=120
# Credentials for the default admin account created on first boot.
DEFAULT_USER_EMAIL=user@example.com
DEFAULT_USER_NAME=root
DEFAULT_USER_PASSWORD=secret



# ---------- NOTIFICATIONS ----------

# --- Emails ---
# Sender address used in the Daily News email.
N8N_EMAIL_FROM=noreply@example.com
# Recipient address for the Daily News email.
N8N_EMAIL_TO=you@example.com

# --- Telegram ---
# Bot token used by workflows that call Telegram Bot API directly.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id



# ---------- WHISPER (audio transcription) ---------- TODO
# Base URL of an OpenAI-compatible Whisper API (no trailing slash).
# Local options: speaches (https://github.com/speaches-ai/speaches),
#                faster-whisper-server (https://github.com/fedirz/faster-whisper-server)
# Cloud option:  https://api.openai.com  (requires WHISPER_MODEL=whisper-1 and an OpenAI key in the n8n credential)
WHISPER_URL=http://speaches:8080
# Model identifier passed to the /v1/audio/transcriptions endpoint.
# Local speaches example: Systran/faster-whisper-large-v3
# OpenAI:                 whisper-1
WHISPER_MODEL=Systran/faster-whisper-large-v3


# --- Slack --- TODO
# Incoming webhook URL from https://api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# --- Discord --- TODO
# Webhook URL from channel Settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK/URL

# --- WhatsApp via Twilio --- TODO
# Account SID and Auth Token from https://console.twilio.com
# n8n credential type: Twilio (store Account SID + Auth Token there, not here)
# From/To must include the whatsapp: prefix. The sandbox FROM is whatsapp:+14155238886.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+1234567890

# --- Pushover --- TODO
# App token from https://pushover.net/apps/build — User key from your Pushover account dashboard.
PUSHOVER_TOKEN=your-app-token
PUSHOVER_USER=your-user-key

# --- Ntfy (self-hosted push notifications) --- TODO
# Self-hosted ntfy server URL (no trailing slash). Topic is the channel name.
# Leave NTFY_TOKEN empty if your server has no auth.
NTFY_URL=http://localhost:2586
NTFY_TOPIC=your-topic
NTFY_TOKEN=

# --- Gotify (self-hosted push notifications) --- TODO
# Self-hosted Gotify server URL (no trailing slash). App token from the Gotify web UI → Apps.
GOTIFY_URL=http://localhost:3001
GOTIFY_TOKEN=your-app-token

# --- Matrix / Element --- TODO
# Homeserver URL (no trailing slash). Access token from Element → Settings → Help & About → Access Token.
# Room ID format: !roomid:server — URL-encode it when pasting into MATRIX_ROOM_ID (! → %21, : → %3A).
MATRIX_HOMESERVER=https://matrix.org
MATRIX_ACCESS_TOKEN=your-access-token
MATRIX_ROOM_ID=!yourroomid%3Amatrix.org

# --- Mastodon --- TODO
# Instance base URL (no trailing slash). Access token from Preferences → Development → New Application.
MASTODON_INSTANCE=https://mastodon.social
MASTODON_ACCESS_TOKEN=your-access-token



# ---------- WORKFLOWS SETTINGS ----------
# Comma-separated list of topics used by the news filter to decide which articles are relevant.
N8N_NEWS_INTERESTS=technology, artificial intelligence, economics, Italian politics, science

# --- OGame read-only attack monitor ---
# Base URL of your OGame server/account status source (no trailing slash).
OGAME_SERVER_URL=https://your-ogame-server.example
# Relative endpoint polled by n8n for attack state.
OGAME_STATUS_ENDPOINT=/api/status
# Optional: full URL override (takes priority over OGAME_SERVER_URL + OGAME_STATUS_ENDPOINT).
OGAME_STATUS_URL=
# Optional Authorization header value (for example: Bearer <token>).
OGAME_STATUS_AUTH_HEADER=
# Monitor interval in minutes (minimum 1). Cron runs every minute and this controls effective poll rate.
OGAME_POLL_INTERVAL_MINUTES=2
# Send a Telegram "clear" message when attacks are no longer detected.
OGAME_SEND_CLEAR_ALERT=true

# Your Linux username — used to mount the shared ~/.ollama model directory into the container.
LINUX_USERNAME=username


# ---------- PORTS ----------
# Host-side port each service is exposed on. Change these if you have conflicts.
N8N_PORT=5678
WEBUI_PORT=3000
OLLAMA_PORT=11434
# URL n8n uses to reach Ollama. Use the Docker service name (ollama) when both run in the same compose stack.
OLLAMA_BASE_URL=http://ollama:11434

# ---------- OLLAMA ----------
# Log level for the Ollama server (DEBUG, INFO, WARN, ERROR).
OLLAMA_DEBUG=INFO
# Log the full request body for every /api/* call — useful for debugging prompts.
OLLAMA_DEBUG_LOG_REQUESTS=true
# Number of CPU threads Ollama uses. Keep low if you want to leave headroom for other processes.
OLLAMA_NUM_THREAD=1
# How long a loaded model stays in VRAM when idle before being evicted. Format: 5m, 1h, 0 (never unload).
OLLAMA_KEEP_ALIVE=5m

# ---------- OLLAMA RESOURCES ----------
# Hard RAM ceiling for the Ollama container (Docker enforced).
OLLAMA_MEM_LIMIT=16g
# Shared memory allocated to the container — CUDA kernels use this for inter-process communication.
OLLAMA_SHM_SIZE=8g
# Maximum CPU cores Docker allows the container to use.
OLLAMA_CPUS=8.0


# ---------- N8N ----------
# Hostname n8n binds to. Use localhost for local-only access, 0.0.0.0 to expose externally.
N8N_HOST=localhost
N8N_PROTOCOL=http
# Base URL used when constructing webhook URLs shown in the UI.
WEBHOOK_URL=http://localhost:5678/
# Timezone for cron triggers and log timestamps.
GENERIC_TIMEZONE=Europe/Rome

# ---------- N8N LLM SETTINGS ----------
# Maximum characters fed to the overview LLM prompt. Higher = richer context, slower and more VRAM.
N8N_OVERVIEW_MAX_CHARS=8000
# Number of GPU layers to offload. Set to 0 to run fully on CPU, or match your model's layer count.
N8N_LLM_NUM_GPU=999

# ---------- DEFAULT CHAT MODEL ----------
# Lightweight, fast model for low-stakes tasks.
N8N_LLM_FAST_MODEL=qwen3.5:9b

# ---------- HEAVY REASONING ----------
# Best for multi-step reasoning, logic chains, math-style thinking.
N8N_LLM_REASONING_MODEL=deepseek-r1:32b
# Best for general intelligence, broad knowledge, strong language tasks.
N8N_LLM_REASONING_MODEL_2=qwen3.6:35b

# ---------- CODE SPECIALIST ----------
N8N_LLM_CODE_MODEL=qwen3-coder:30b

# ---------- VISION MODEL ----------
# Multimodal model capable of understanding images alongside text.
N8N_LLM_VISION_MODEL=llava:13b

# ---------- EMBEDDINGS ----------
# Embedding model used for semantic search and similarity tasks.
N8N_LLM_EMBED_MODEL=nomic-embed-text

# ---------- WEBUI ----------
# Allow new users to self-register. Set to false once you have created your account.
ENABLE_SIGNUP=true
# Secret used to sign session tokens. Must be a long random string in production.
WEBUI_SECRET_KEY=change-me-to-a-long-random-secret
# Maximum tokens the model can generate per response in the chat UI.
MAX_RESPONSE_TOKENS=1024
# Seconds before an in-flight request to Ollama is cancelled by the web UI.
REQUEST_TIMEOUT=120
# Credentials for the default admin account created on first boot.
DEFAULT_USER_EMAIL=user@example.com
DEFAULT_USER_NAME=root
DEFAULT_USER_PASSWORD=secret


# ---------- WORKFLOWS SETTINGS ----------
# Comma-separated list of topics used by the news filter to decide which articles are relevant.
N8N_NEWS_INTERESTS=technology, artificial intelligence, economics, Italian politics, science
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  model: \"qwen3.6:35b\",\n  prompt: `You are a news editor writing for ADHD readers. The article may be in Italian — read it, understand it, and write a concise English summary.\n\nARTICLE:\nTitle: ${$json.title}\nSource: ${$json.source}\n\n${$json.article || $json.snippet || ''}\n\n---\n\nWrite a summary following these rules:\n- ADHD friendly\n- Significant or complex news: use **bold** for key names, numbers, dates\n- No fluff, no repetition, no meta-commentary\n- Do NOT include URLs, source names, or the title — only the summary text\n- Write in English regardless of the article's original language\n`,\n  stream: false,\n  keep_alive: \"30m\"\n} }}",
        "options": {
          "timeout": 600000
        }
      },
